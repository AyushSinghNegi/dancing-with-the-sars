<mxfile host="app.diagrams.net" type="device"><diagram id="rsn" name="RSN pipeline"><mxGraphModel page="1" pageWidth="1100" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MonsoonLens | RSN data and science hand-offs" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#475569;fontSize=16;"><mxGeometry as="geometry" x="70" y="20" width="960" height="55" /></mxCell><mxCell id="data" value="LOCAL / EARTHDATA&#10;Five compatible GCOV scenes + primary GUNW pair&#10;Primary IDs in config.py" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#475569;fontSize=16;"><mxGeometry as="geometry" x="70" y="115" width="440" height="90" /></mxCell><mxCell id="reference" value="REFERENCE INPUTS&#10;JRC + NASADEM / slope + events + rainfall&#10;Explicit zone polygons" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#475569;fontSize=16;"><mxGeometry as="geometry" x="590" y="115" width="440" height="90" /></mxCell><mxCell id="crop" value="R1–R4 | inspect_h5 → crop → quality → preflight&#10;Windowed reads, validity/anomaly masks, coordinate alignment&#10;data/crops/ • inspection reports • manifest" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#475569;fontSize=16;"><mxGeometry as="geometry" x="160" y="260" width="780" height="100" /></mxCell><mxCell id="analysis" value="R5–R9 | water → slide_zones → control → validate → timeline&#10;Shared linear Otsu + quality check • 20° HV-drop slides • 200 m matches&#10;Same-mode HH/HV timeline.csv • reviewed footprints and sample counts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#475569;fontSize=16;"><mxGeometry as="geometry" x="160" y="415" width="780" height="100" /></mxCell><mxCell id="publish" value="run_all + render&#10;Derived bundle: PNG/WebP, GeoTIFF, GeoJSON, CSV, metadata&#1